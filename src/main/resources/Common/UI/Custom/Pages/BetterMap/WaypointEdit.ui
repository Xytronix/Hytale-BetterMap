$C = "../../Common.ui";

@TransparentBtn = TextButtonStyle(
    Default: (Background: #000000(0)),
    Hovered: (Background: #FFFFFF(0.2)),
    Pressed: (Background: #FFFFFF(0.3)),
    Disabled: (Background: #000000(0)),
    Sounds: $C.@ButtonSounds
);

@NavBtn = TextButtonStyle(
    Default: (Background: #3d5a85, LabelStyle: (TextColor: #FFFFFF)),
    Hovered: (Background: #5078a8, LabelStyle: (TextColor: #FFFFFF)),
    Pressed: (Background: #2a4060, LabelStyle: (TextColor: #FFFFFF)),
    Disabled: (Background: #222222, LabelStyle: (TextColor: #666666)),
    Sounds: $C.@ButtonSounds
);

$C.@PageOverlay {
  $C.@DecoratedContainer {
    Anchor: (Width: 450, Height: 500);

    #Title {
      $C.@Title {
        @Text = "Edit Waypoint";
      }
      TextButton #BackButton {
        Anchor: (Left: 12, Top: 4, Width: 48, Height: 24);
        Style: @NavBtn;
        Text: "Back";
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 20);

      Label {
        Text: "Name";
        Style: (FontSize: 16, TextColor: #93844c, RenderBold: true); 
        Anchor: (Height: 20);
      }
      $C.@TextField #NameInput {
        Anchor: (Height: 40);
        PlaceholderText: "Waypoint Name...";
        PlaceholderStyle: (TextColor: #3d5a85, FontSize: 14);
      }

      Label {
        Text: "Coordinates (X / Z)";
        Style: (FontSize: 16, TextColor: #93844c, RenderBold: true); 
        Anchor: (Height: 20);
      }
      Group #CoordsRow {
        LayoutMode: Left;
        Anchor: (Height: 40);
        $C.@TextField #InputX { FlexWeight: 1; PlaceholderText: "X"; }
        Panel { Anchor: (Width: 10, Height: 1); }
        $C.@TextField #InputZ { FlexWeight: 1; PlaceholderText: "Z"; }
      }

      Label {
        Text: "Icon";
        Style: (FontSize: 16, TextColor: #93844c, RenderBold: true); 
        Anchor: (Height: 20, Top: 10);
      }
      Group #IconRow {
        LayoutMode: Left;
        Anchor: (Height: 36);

        TextButton #IconPrev {
          Anchor: (Width: 36, Height: 36);
          Style: @NavBtn;
          Text: "<";
        }
        
        Group {
          FlexWeight: 1;
          LayoutMode: Left;
          
          Panel #IconPreview {
            Anchor: (Width: 24, Height: 24, Left: 10);
            Background: "../../Common/UserA.png"; 
          }
          
          Label #IconLabel {
            Anchor: (Left: 10);
            Style: (FontSize: 14, TextColor: #d3d6db);
            Text: "UserA";
          }
        }

        TextButton #IconNext {
          Anchor: (Width: 36, Height: 36);
          Style: @NavBtn;
          Text: ">";
        }
      }

      Label {
        Text: "Color Tint";
        Style: (FontSize: 16, TextColor: #93844c, RenderBold: true); 
        Anchor: (Height: 20, Top: 10);
      }
      Group #TintRow {
        LayoutMode: Left;
        Anchor: (Height: 36);

        TextButton #TintPrev {
          Anchor: (Width: 36, Height: 36);
          Style: @NavBtn;
          Text: "<";
        }
        
        Group {
          FlexWeight: 1;
          LayoutMode: Left;
          
          Panel #ColorPreview {
            Anchor: (Width: 24, Height: 24, Left: 10);
            Background: #FFFFFF;
          }
          
          Label #ColorLabel {
            Anchor: (Left: 10);
            Style: (FontSize: 14, TextColor: #d3d6db);
            Text: "White";
          }
        }

        TextButton #TintNext {
          Anchor: (Width: 36, Height: 36);
          Style: @NavBtn;
          Text: ">";
        }
      }

      Group #GlobalRow {
        LayoutMode: Left;
        Anchor: (Top: 12, Height: 28);
        Visible: false;

        $C.@CheckBox #GlobalCheckbox {
          Anchor: (Width: 24, Height: 24);
        }

        Label {
          Anchor: (Left: 8);
          Style: (FontSize: 14, TextColor: #d3d6db);
          Text: "Shared waypoint (visible to everyone)";
        }
      }

      Group #ActionRow {
        LayoutMode: Left;
        Anchor: (Top: 20);

        $C.@TextButton #SaveButton {
          Anchor: (Height: 28, Right: 8);
          Padding: (Left: 16, Right: 16, Top: 6, Bottom: 6);
          Text: "Save";
        }

        $C.@CancelTextButton #CancelButton {
          Anchor: (Height: 28);
          Padding: (Left: 16, Right: 16, Top: 6, Bottom: 6);
          Text: "Cancel";
        }
      }
    }
  }
}
